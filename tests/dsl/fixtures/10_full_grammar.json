{
  "strategy": {
    "name": "FullGrammarSmokeStrat",
    "htf": "30m",
    "ltf": "1m",
    "dsl_version": "1"
  },
  "indicators": [
    {"id": "trend_ema", "type": "ema", "on": "htf", "period": 50},
    {"id": "fast_sma", "type": "sma", "on": "ltf", "period": 9},
    {"id": "atr_band", "type": "atr", "period": 14},
    {"id": "channel", "type": "donchian", "period": 20},
    {"id": "ott_band", "type": "ott", "period": 21, "factor": 0.5},
    {"id": "p_close", "type": "pivots_close", "on": "htf"},
    {"id": "p_high", "type": "pivots", "on": "ltf"},
    {"id": "ltf_cisd", "type": "cisd", "lookback": 1},
    {"id": "fvg_zone", "type": "fvg", "on": "htf"},
    {"id": "session_window", "type": "time_of_day", "window": "09:30-11:30"}
  ],
  "filters": [
    {"id": "bull_cross", "type": "cross_above", "lhs": "fast_sma", "rhs": "trend_ema"},
    {"id": "bear_cross", "type": "cross_below", "lhs": "fast_sma", "rhs": "trend_ema"},
    {"id": "above_chan", "type": "break_above", "lhs": "close", "rhs": "channel"},
    {"id": "below_chan", "type": "break_below", "lhs": "close", "rhs": "channel"},
    {"id": "tap_fvg", "type": "in_zone", "source": "close", "zone": "fvg_zone"},
    {"id": "in_hours", "type": "tf_window"},
    {"id": "weekday_ok", "type": "weekday", "days": ["mon", "tue", "wed", "thu", "fri"]},
    {"id": "no_eod", "type": "not_eod", "n": 3},
    {"id": "cisd_bull", "type": "equals", "lhs": "ltf_cisd", "rhs": 1}
  ],
  "entries": [
    {"when": "bull_cross", "do": "buy_at_next_open"},
    {"when": "bear_cross", "do": "sell_at_next_open"},
    {"when": "tap_fvg", "do": "tag_trade", "tag": "fvg-tap"},
    {"when": "no_eod", "do": "cancel_pending"}
  ],
  "exits": [
    {"type": "fixed_pts_sl", "pts": 8},
    {"type": "atr_mult_sl", "mult": 2.0},
    {"type": "pivot_sl", "anchor": "p_close"},
    {"type": "fixed_rr_tp", "rr": 2.5},
    {"type": "move_to_be", "after_pts": 6}
  ],
  "risk": {
    "risk_pct": 1.0,
    "lot_cap": {"per_100k": 12},
    "max_open": 1
  }
}
